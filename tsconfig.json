{
  // Type-checks src/; cli/tsconfig.json extends it for the CLI. tsdown writes the JavaScript, and Oxc the bundled
  // .d.ts files, which isolated declarations let it do without the TypeScript compiler.
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "noEmit": true,
    "declaration": true,
    "stripInternal": true,
    "isolatedDeclarations": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
