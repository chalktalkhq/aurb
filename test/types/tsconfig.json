{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom"],
    "types": [],
    "paths": {
      "@aurb/player": ["../../dist/aurb.d.ts"],
      "@aurb/player/react": ["../../dist/react.d.ts"],
      "@aurb/player/prefetch": ["../../dist/prefetch.d.ts"],
      "@aurb/player/global": ["../../dist/global.d.ts"]
    }
  },
  "include": ["*.tsx", "*.ts"]
}
