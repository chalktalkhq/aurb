{
  // Type-checks src/ and writes the published .d.ts files into dist/. esbuild writes the JavaScript.
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "declaration": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
